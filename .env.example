APP_NAME="Novastaq Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://store.novastaq.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paystack: Dashboard > Settings > API Keys & Webhooks (use sk_test_ keys until launch)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Tsara: Dashboard > Developers > API Keys (sandbox: https://sandbox.tsara.ng/v1, live: https://api.tsara.ng/v1)
TSARA_PUBLIC_KEY=
TSARA_SECRET_KEY=
TSARA_BASE_URL=https://api.tsara.ng/v1

# Nomba: Dashboard > Developers > API Keys & Webhooks (live: https://api.nomba.com, sandbox: https://sandbox.nomba.com)
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_ACCOUNT_ID=
NOMBA_BASE_URL=https://api.nomba.com
NOMBA_WEBHOOK_SECRET=

# Store
STORE_DELIVERY_FEE=2000
MAIN_SITE_URL=https://novastaq.com
STORE_SUPPORT_EMAIL=hello@novastaq.com
STORE_ADMIN_EMAILS=hello@novastaq.com,novastaqtechnologies@gmail.com
STORE_WHATSAPP_URL=https://wa.me/2348150533325

# One-time /install page (no-shell hosting). Remove after setup.
INSTALL_TOKEN=

# Email via Mailhive Send (dashboard > Send > API keys). Empty = emails are only logged.
MAILHIVE_API_KEY=
MAIL_FROM="Novastaq Store <hello@novastaq.com>"
